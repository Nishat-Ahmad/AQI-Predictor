---
// 3-Day Forecast Cards Component
---

<section class="content-section">
    <div class="section-topbar">
        <div>
            <h3 class="section-heading">3-Day Air Quality & Weather Outlook</h3>
            <p class="section-subtext">Aggregated diurnal peaks, dominant drivers, and medical health advisories</p>
        </div>
        <div class="horizon-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>72-Hour Horizon</span>
        </div>
    </div>

    <!-- Dynamic 3-Day Cards Container -->
    <div class="weather-days-grid" id="day-cards-container">
        <!-- Rendered by frontend/js/ui.js -->
    </div>
</section>
