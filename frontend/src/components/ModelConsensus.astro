---
// Multi-Model Machine Learning Consensus Component (RF, Ridge, PyTorch MLP)
---

<div class="frost-card hero-model-card">
    <div class="card-super-header">
        <h3 class="widget-title">Multi-Model AI Suite</h3>
        <span class="badge-mini">3 Algorithms</span>
    </div>
    
    <p class="widget-sub">Concurrent inference across statistical and neural networks:</p>

    <div class="model-forecast-tiles">
        <div class="model-tile">
            <div class="m-left">
                <span class="m-title">Random Forest</span>
                <span class="m-desc">Non-linear ensemble</span>
            </div>
            <span class="m-score" id="rf-score">--</span>
        </div>

        <div class="model-tile">
            <div class="m-left">
                <span class="m-title">Ridge Regression</span>
                <span class="m-desc">L2 regularized baseline</span>
            </div>
            <span class="m-score" id="ridge-score">--</span>
        </div>

        <div class="model-tile">
            <div class="m-left">
                <span class="m-title">Deep Learning</span>
                <span class="m-desc">PyTorch 4-layer MLP</span>
            </div>
            <span class="m-score" id="dl-score">--</span>
        </div>
    </div>

    <!-- Ensemble Consensus Footer -->
    <div class="consensus-footer">
        <div class="cf-left">
            <span class="cf-tag">Ensemble Consensus</span>
            <span class="cf-sub">Weighted multi-model mean</span>
        </div>
        <span class="cf-score" id="consensus-score">-- AQI</span>
    </div>
</div>
