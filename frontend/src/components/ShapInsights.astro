---
// Explainable AI (SHAP) Insights & Health Protection Advisories Component
---

<section class="content-section">
    <div class="bottom-insights-grid">
        
        <!-- SHAP Driver Insights -->
        <div class="frost-card">
            <div class="card-super-header">
                <h3 class="widget-title">Explainable AI (SHAP Impact)</h3>
                <span class="badge-mini">TreeExplainer</span>
            </div>
            <p class="widget-sub">Relative feature drivers pulling predicted AQI higher (+) or lower (-):</p>
            <div class="shap-canvas-container">
                <canvas id="shapChart"></canvas>
            </div>
        </div>

        <!-- Health Protection Advisories -->
        <div class="frost-card">
            <div class="card-super-header">
                <h3 class="widget-title">Atmospheric Protection Guide</h3>
                <span class="badge-mini">Health Advisory</span>
            </div>
            <p class="widget-sub">Clinical recommendations based on live air conditions:</p>
            
            <div class="advisory-tiles">
                <div class="advisory-card">
                    <div class="adv-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12h20M2 12a10 10 0 0 1 18-6M2 12a10 10 0 0 0 18 6"/>
                        </svg>
                    </div>
                    <div class="adv-body">
                        <h4>Outdoor Activity Guidance</h4>
                        <p id="adv-outdoor">Moderate air quality. Limit strenuous outdoor cardio during peak morning hours.</p>
                    </div>
                </div>

                <div class="advisory-card">
                    <div class="adv-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"/>
                            <path d="M3 9h18M9 21V9"/>
                        </svg>
                    </div>
                    <div class="adv-body">
                        <h4>Indoor Ventilation</h4>
                        <p id="adv-indoor">Run HEPA air purifiers and seal windows when particulate concentration spikes.</p>
                    </div>
                </div>

                <div class="advisory-card">
                    <div class="adv-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                        </svg>
                    </div>
                    <div class="adv-body">
                        <h4>Sensitive Population</h4>
                        <p id="adv-sensitive">Children, elderly, and asthma patients should avoid strenuous cardio.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
