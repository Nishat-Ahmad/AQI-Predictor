---
// Interactive World Capitals Map Component (Leaflet.js)
---

<section class="frost-card map-card-container">
    <div class="map-header-bar">
        <div class="map-title-group">
            <div class="map-city-pill" id="map-selected-city">London, United Kingdom</div>
        </div>

        <div class="map-controls-group">
            <!-- Real-time Interactive Search Bar -->
            <div class="capital-search-box">
                <div class="search-input-wrapper">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" id="capital-search-input" class="capital-search-input" placeholder="Search capital or country..." autocomplete="off" />
                    <button type="button" id="btn-clear-search" class="clear-search-btn" title="Clear search" style="display: none;">&times;</button>
                </div>
                <div id="search-results-dropdown" class="search-results-dropdown" style="display: none;"></div>
            </div>
        </div>
    </div>

    <!-- Leaflet Map Canvas Container -->
    <div class="map-canvas-wrapper">
        <div id="world-map"></div>
    </div>
</section>
