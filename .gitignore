# Environment & Logs
.env
wandb/
**/wandb/

# Node & Astro
node_modules/
**/node_modules/
dist/
**/dist/
.astro/
**/.astro/

# Data & Artifacts (ignore all nested folders except .gitkeep)
data/**
!data/.gitkeep
artifacts/**
!artifacts/.gitkeep

# Model weights, datasets, checkpoints everywhere
*.pkl
**/*.pkl
*.pt
**/*.pt
*.joblib
**/*.joblib
*.csv
**/*.csv

# Python Caches & Checkpoints
**/__pycache__/
*.pyc
**/*.pyc
.ipynb_checkpoints/
**/.ipynb_checkpoints/
